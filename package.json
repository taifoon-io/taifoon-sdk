{
  "name": "@taifoon/sdk",
  "version": "0.1.0-pre.1",
  "description": "One key for cross-chain proof, gas, signals, execution, and the Taifoon Builders Programme registry.",
  "license": "Apache-2.0",
  "homepage": "https://taifoon.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taifoon-io/taifoon-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/taifoon-io/taifoon-sdk/issues",
    "email": "taifooon@proton.me"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./proof": "./dist/proof/index.js",
    "./gas": "./dist/gas/index.js",
    "./signals": "./dist/signals/index.js",
    "./executor": "./dist/executor/index.js",
    "./registry": "./dist/registry/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example:fill": "tsx examples/quote-and-fill.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.2",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "taifoon",
    "cross-chain",
    "v5-proof",
    "mmr-proof",
    "solver",
    "bridge",
    "intent",
    "settlement",
    "fair-code",
    "tsul"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
